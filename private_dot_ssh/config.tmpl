# =============================================================================
# SSH Config — ENCRYPTED
# =============================================================================
# ENCRYPTED FILE — managed by chezmoi with age encryption.
#
# ⚠️  KEY ROTATION: When you rotate your age key:
#    1. Edit this file: chezmoi edit ~/.ssh/config
#    2. Make your changes and save (chezmoi re-encrypts automatically)
#    3. Commit the updated .age file
#
# ⚠️  ADDING A NEW HOST:
#    1. Edit: chezmoi edit ~/.ssh/config
#    2. Add the new Host block
#    3. Save — chezmoi re-encrypts automatically
#    4. Commit the updated .age file
# =============================================================================
{{- if eq .chezmoi.os "darwin" }}
Include /Users/aox/.colima/ssh_config
{{- end }}

Host *
  AddKeysToAgent yes
{{- if eq .chezmoi.os "darwin" }}
  UseKeychain yes
{{- end }}
  IdentitiesOnly yes

Host bitbucket.org
  HostName bitbucket.org
  IdentityFile ~/.ssh/bitbucket_id_rsa
  User agustinottobre

Host github.com
  HostName github.com
  IdentityFile ~/.ssh/github_id_rsa
  User agustinottobre

Host gitlab.com
  HostName gitlab.com
  IdentityFile ~/.ssh/gitlab_id_rsa
  User agustinottobre

Host tower 192.168.127.7 tower.net.cloud
  HostName 192.168.127.7
  IdentityFile ~/.ssh/tower_id_rsa
  User root

Host tower.local
  HostName tower.local
  IdentityFile ~/.ssh/tower_id_rsa
  User root

Host tower01.local
  HostName tower01.local
  IdentityFile ~/.ssh/tower_id_rsa
  User root

Host tower02.local
  HostName tower02.local
  IdentityFile ~/.ssh/tower_id_rsa
  User root

Host hostinger
  HostName 62.72.37.186
  Port 65002
  IdentityFile ~/.ssh/hostinger_id_rsa
  User u240016104

Host solarbox-web
  HostName 157.90.18.48
  User root
  IdentityFile ~/.ssh/solarbox_id_rsa
  PreferredAuthentications publickey

Host ssh-aox.alwaysdata.net
  HostName ssh-aox.alwaysdata.net
  User aox
  IdentityFile ~/.ssh/alwaysdata_id_ed25519

{{- if eq .chezmoi.os "darwin" }}
Host lima-default
  IdentityFile "/Users/aox/.lima/_config/user"
  StrictHostKeyChecking no
  UserKnownHostsFile /dev/null
  NoHostAuthenticationForLocalhost yes
  GSSAPIAuthentication no
  PreferredAuthentications publickey
  Compression no
  BatchMode yes
  IdentitiesOnly yes
  Ciphers "^aes128-gcm@openssh.com,aes256-gcm@openssh.com"
  User aox
  ControlMaster auto
  ControlPath "/Users/aox/.lima/default/ssh.sock"
  ControlPersist yes
  HostName 127.0.0.1
  Port 60022
{{- end }}

Host router
  HostName 102.168.127.1
  User root
  IdentityFile ~/.ssh/linksys_wrt3200acm_id

