[user]
    name = {{ .git.userName | default "Agustin Ottobre" | quote }}
    email = {{ .git.userEmail | default "agustin.ottobre@gmail.com" | quote }}
[diff]
  tool = vimdiff
[difftool]
  prompt = false
  trustExitCode = true
[alias]
  d = difftool
  m = mergetool
[merge]
  tool = vimdiff
[mergetool]
  prompt = false
  trustExitCode = true
  keepBackup = false
[core]
  excludesfile = ~/.gitignore
[filter "lfs"]
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
