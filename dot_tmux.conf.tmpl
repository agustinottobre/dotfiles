# command delay after escape key? We don't want that, make it short
set -sg escape-time 0

# fire focus events on panes like FocusGained and FocusLost in vim
set -g focus-events on

# Set the numbering of windows to go from 1 instead of 0
set -g base-index 1                         # start window names at 1 (!0)
setw -g pane-base-index 1

setw -g monitor-activity on
set -g visual-activity on

set -g history-limit 10000
set -g default-terminal "tmux-256color"
set -ga terminal-overrides ",*256col*:Tc"
set -g status-keys vi

set-option -g set-clipboard on

# Automatically set window title
set-window-option -g automatic-rename on
set-option -g set-titles on

# Style for the active window tab
set-window-option -g window-status-current-style fg=black,bg=yellow,bold
set-window-option -g window-status-current-format " #I:#W#F "

# Style for inactive window tabs
set-window-option -g window-status-style fg=white,bg=black,dim
set-window-option -g window-status-format " #I:#W#F "

# Status bar
set -g status-style bg=terminal,fg=white

# Style for windows with background activity
set-window-option -g window-status-activity-style fg=white,bg=black,none

# =============================================================================
# Mouse & Key Bindings
# =============================================================================

## Enable mouse support
setw -g mouse on

# Key bindings
set -g mode-keys vi                         # use vi mode

# Set new panes to open in current directory
bind c new-window -c "#{pane_current_path}"
unbind '"'
bind s split-window -c "#{pane_current_path}"
unbind %
bind v split-window -h -c "#{pane_current_path}"

# Copy mode vi bindings
bind Escape copy-mode
bind-key -Tcopy-mode-vi 'v' send -X begin-selection
bind-key -Tcopy-mode-vi 'y' send -X copy-selection-and-cancel
bind-key -Tcopy-mode-vi 'r' send -X rectangle-toggle
bind-key -Tcopy-mode-vi 'Space' send -X halfpage-down
bind-key -Tcopy-mode-vi 'Bspace' send -X halfpage-up

# =============================================================================
# Clipboard Integration (OS-agnostic)
# =============================================================================

# Copy to system clipboard (C-c in normal mode)
bind C-c run "tmux save-buffer - | if command -v pbcopy >/dev/null 2>&1; then pbcopy; elif command -v xclip >/dev/null 2>&1; then xclip -selection clipboard; elif command -v xsel >/dev/null 2>&1; then xsel -ib; fi"

# Paste from system clipboard (C-v in normal mode)
bind C-v run "tmux set-buffer \"$(if command -v pbpaste >/dev/null 2>&1; then pbpaste; elif command -v xclip >/dev/null 2>&1; then xclip -selection clipboard -o 2>/dev/null; elif command -v xsel >/dev/null 2>&1; then xsel -ob; fi)\"; tmux paste-buffer"

# =============================================================================
# Smart Pane Switching (with Neovim awareness)
# =============================================================================

# Smart pane switching with awareness of Neovim splits
bind-key -n C-h if -F "#{@pane-is-vim}" 'send-keys C-h'  'select-pane -L'
bind-key -n C-j if -F "#{@pane-is-vim}" 'send-keys C-j'  'select-pane -D'
bind-key -n C-k if -F "#{@pane-is-vim}" 'send-keys C-k'  'select-pane -U'
bind-key -n C-l if -F "#{@pane-is-vim}" 'send-keys C-l'  'select-pane -R'

# Smart pane resizing (Alt key)
bind-key -n M-h if -F "#{@pane-is-vim}" 'send-keys M-h' 'resize-pane -L 3'
bind-key -n M-j if -F "#{@pane-is-vim}" 'send-keys M-j' 'resize-pane -D 3'
bind-key -n M-k if -F "#{@pane-is-vim}" 'send-keys M-k' 'resize-pane -U 3'
bind-key -n M-l if -F "#{@pane-is-vim}" 'send-keys M-l' 'resize-pane -R 3'

# Last pane navigation (C-\)
bind-key -n 'C-\' if -F "#{@pane-is-vim}" "send-keys C-\\" "select-pane -l"

# Copy-mode vi pane navigation
bind-key -T copy-mode-vi 'C-h' select-pane -L
bind-key -T copy-mode-vi 'C-j' select-pane -D
bind-key -T copy-mode-vi 'C-k' select-pane -U
bind-key -T copy-mode-vi 'C-l' select-pane -R
bind-key -T copy-mode-vi 'C-\' select-pane -l

# =============================================================================
# SSH & Reload
# =============================================================================

# ssh
bind-key S command-prompt -p ssh: "new-window -n %1 'ssh %1'"

# Reload tmux config
bind r source-file ~/.tmux.conf \; display-message "Config reloaded..."

# =============================================================================
# Plugins (TPM)
# =============================================================================

# List of plugins
set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'tmux-plugins/tmux-resurrect'
set -g @plugin 'tmux-plugins/tmux-continuum'
set -g @plugin 'mrjones2014/smart-splits.nvim'

# TPM plugin variables
set -g @smart-splits_no_wrap ''
set -g @smart-splits_move_left_key  'C-h'
set -g @smart-splits_move_down_key  'C-j'
set -g @smart-splits_move_up_key    'C-k'
set -g @smart-splits_move_right_key 'C-l'
set -g @smart-splits_resize_left_key  'M-h'
set -g @smart-splits_resize_down_key  'M-j'
set -g @smart-splits_resize_up_key    'M-k'
set -g @smart-splits_resize_right_key 'M-l'
set -g @smart-splits_resize_step_size '1'

### Initialize TMUX plugin manager (keep this line at the very bottom of tmux.conf)
run '~/.tmux/plugins/tpm/tpm'
