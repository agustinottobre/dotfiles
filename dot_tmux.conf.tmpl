# command delay after escape key? We don't want that, make it short
set -sg escape-time 0

# fire focus events on panes like FocusGained and FocusLost in vim
set -g focus-events on

# Set the numbering of windows to go from 1 instead of 0
set -g base-index 1                         # start window names at 1 (!0)
setw -g pane-base-index 1

setw -g monitor-activity on
set -g visual-activity on

set -g history-limit 10000
set -g default-terminal "tmux-256color"
set -ga terminal-overrides ",*256col*:Tc"
set -g status-keys vi

set-option -g set-clipboard on

# Automatically set window title
set-window-option -g automatic-rename on
set-option -g set-titles on
# =============================================================================
# Profile-based Theme Tweaks
# =============================================================================
# If we are on a server, change the status bar background to red to warn us
if-shell '[ "$DOTFILES_PROFILE" = "server-headless" ]' \
    "set -g status-style bg=red,fg=white; set-window-option -g window-status-current-style fg=white,bg=black,bold" \
    "set -g status-style bg=terminal,fg=white; set-window-option -g window-status-current-style fg=black,bg=yellow,bold"

# Style for the active window tab (Default/Mac)
# (The if-shell above overrides this if on server)
# set-window-option -g window-status-current-style fg=black,bg=yellow,bold
set-window-option -g window-status-current-format " #I:#W#F "

# Style for inactive window tabs
# This dims them slightly so they recede into the background
#set-window-option -g window-status-style fg=white,bg=black,dim
set-window-option -g window-status-style fg=white,bg=black,dim
set-window-option -g window-status-format " #I:#W#F "

# Optional: Add a bit of color to the status bar background itself
set -g status-style bg=terminal,fg=white

# Style for windows with background activity (subtle yellow text, no block)
#set-window-option -g window-status-activity-style fg=grey,bg=terminal,none
set-window-option -g window-status-activity-style fg=white,bg=black,none



## Enable mouse support
setw -g mouse on

# Key bindings
set -g mode-keys vi                         # use vi mode

# Set new panes to open in current directory
bind c new-window -c "#{pane_current_path}"
unbind '"'
bind s split-window -c "#{pane_current_path}"
unbind %
bind v split-window -h -c "#{pane_current_path}"

# y and p as in vim
#unbind [
bind Escape copy-mode
#unbind p
#bind p paste-buffer
bind-key -Tcopy-mode-vi 'v' send -X begin-selection
bind-key -Tcopy-mode-vi 'y' send -X copy-selection
bind-key -Tcopy-mode-vi 'r' send -X rectangle-toggle
bind-key -Tcopy-mode-vi 'Space' send -X halfpage-down
bind-key -Tcopy-mode-vi 'Bspace' send -X halfpage-up

# Clipboard integration
# Check for xsel (Linux) or pbcopy/pbpaste (macOS)
if-shell 'command -v xsel >/dev/null 2>&1' \
    "bind C-c choose-buffer \"run 'tmux save-buffer -b %% - | xsel -ib'\"; bind C-v run \"tmux set-buffer '$(xsel -ob)'; tmux paste-buffer\"" \
    ""
if-shell 'command -v pbcopy >/dev/null 2>&1' \
    "bind C-c choose-buffer \"run 'tmux save-buffer -b %% - | pbcopy'\"; bind C-v run \"tmux set-buffer '$(pbpaste)'; tmux paste-buffer\"" \
    ""

# Pane resizing - using smart-splits.nvim (Alt key)
# Old bindings removed - smart-splits handles this with @pane-is-vim awareness

# ssh
bind-key S command-prompt -p ssh: "new-window -n %1 'ssh %1'"

# Reload tmux config
bind r source-file ~/.tmux.conf \; display-message "Config reloaded..."

# set inactive/active window styles
