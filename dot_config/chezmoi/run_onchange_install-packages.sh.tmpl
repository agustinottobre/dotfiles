#!/bin/bash
# =============================================================================
# chezmoi run_onchange script: Install packages based on OS
# Triggered whenever chezmoi apply runs
# =============================================================================

# Allow script to continue even if individual commands fail
# set -e  # Disabled - we handle errors manually
# set -o pipefail

# Helper to check if a command exists
command_exists() {
    command -v "$1" >/dev/null 2>&1
}



# --- Package Installation Functions ---

install_apt_packages() {
    echo "Updating apt repositories..."
    sudo apt-get update -qq
    echo "Installing packages from apt.txt..."
    local packages=$(sed -e 's/^#.*//' -e 's/^$/DONE/' "{{ .chezmoi.sourceDir }}/packages/apt.txt" 2>/dev/null | grep -v DONE | tr '\n' ' ')
    if [ -n "$packages" ]; then
        # Try packages in batches, skipping any that fail
        for pkg in $packages; do
            sudo apt-get install -y -qq "$pkg" 2>/dev/null || true
        done
    fi
}

install_brew_packages() {
    if ! command_exists brew; then
        echo "Homebrew not found. Skipping brew packages."
        return
    fi
    echo "Updating Homebrew..."
    brew update -q
    echo "Installing packages from brew.txt..."
    local packages=$(sed -e 's/^#.*//' -e 's/^$/DONE/' "{{ .chezmoi.sourceDir }}/packages/brew.txt" 2>/dev/null | grep -v DONE | tr '\n' ' ')
    if [ -n "$packages" ]; then
        # Try packages individually, skipping any that fail
        for pkg in $packages; do
            brew install -q "$pkg" 2>/dev/null || true
        done
    fi
}

# --- FNM Installation (cross-platform) ---

install_fnm() {
    local fnm_dir="$HOME/.fnm"
    local fnm_exe="$fnm_dir/fnm"

    if command_exists fnm && [ -f "$fnm_exe" ]; then
        echo "FNM already installed."
        return
    fi

    echo "Installing FNM..."
    curl -fsSL https://fnm.vercel.app/install | bash -s -- --install-dir "$fnm_dir" --skip-shell
    echo "FNM installed to $fnm_dir"
}

# --- Starship Installation (cross-platform) ---

install_starship() {
  if command_exists starship; then
    echo "Starship already installed."
    return
  fi

  echo "Installing Starship..."
  # Try the official installer first (requires bash, not sh)
  if timeout 60 bash -c 'curl -sS https://starship.dev/install.sh | bash -s -- -y' 2>/dev/null && command_exists starship; then
    echo "Starship installed via official installer."
    return
  fi

  # Fallback: install directly from GitHub releases
  echo "Official installer failed. Installing from GitHub releases..."
  local arch=$(uname -m)
  local starship_url="https://github.com/starship/starship/releases/latest/download/starship-${arch}-unknown-linux-gnu.tar.gz"
  if curl -fsSL "$starship_url" | tar -xzf - -C /usr/local/bin starship 2>/dev/null; then
    chmod +x /usr/local/bin/starship
    echo "Starship installed from GitHub releases."
  else
    echo "WARNING: Starship installation failed. Install manually: https://starship.rs/"
  fi
}

# --- Neovim on Linux (AppImage) ---

install_neovim_linux() {
    local nvim_bin="{{ .chezmoi.homeDir }}/.local/bin/nvim"
    local nvim_version

    if command_exists nvim; then
        echo "Neovim already installed."
        return
    fi

    echo "Installing Neovim (latest AppImage)..."

    # Try to get latest version or fall back to known stable
    nvim_version=$(curl -sL https://api.github.com/repos/neovim/neovim/releases/latest 2>/dev/null | grep '"tag_name":' | sed -E 's/.*"([^"]+)".*/\1/' || echo "v0.10.0")
    nvim_version=${nvim_version#v}

    mkdir -p "{{ .chezmoi.homeDir }}/.local/bin"

    curl -fsSL -o "$nvim_bin" "https://github.com/neovim/neovim/releases/download/v${nvim_version}/nvim-linux-x86_64.appimage"
    chmod u+x "$nvim_bin"

    # Check if FUSE is available, if not, extract the AppImage
    if ! "$nvim_bin" --version >/dev/null 2>&1; then
        echo "FUSE not detected. Extracting AppImage..."
        local old_pwd=$(pwd)
        cd "{{ .chezmoi.homeDir }}/.local/bin"
        "$nvim_bin" --appimage-extract >/dev/null 2>&1 || true
        if [ -d "squashfs-root" ]; then
            rm -rf "nvim-extracted"
            mv "squashfs-root" "nvim-extracted"
            printf '#!/bin/bash\n%s/.local/bin/nvim-extracted/AppRun "$@"\n' "$HOME" > nvim
            chmod +x nvim
        fi
        cd "$old_pwd"
    fi

    echo "Neovim installed to $nvim_bin"
}

# --- TPM (Tmux Plugin Manager) Installation ---

install_tpm() {
    local tpm_dir="{{ .chezmoi.homeDir }}/.tmux/plugins/tpm"

    if [ -d "$tpm_dir" ]; then
        echo "TPM already installed."
        return
    fi

    echo "Installing TPM..."
    git clone -q https://github.com/tmux-plugins/tpm "$tpm_dir"
}

# --- Age Key for Chezmoi ---

install_age_key() {
    local key_file="{{ .chezmoi.homeDir }}/.config/chezmoi/key.txt"

    if [ -f "$key_file" ]; then
        echo "Age key already exists."
        return
    fi

    if command_exists age-keygen; then
        echo "Generating age key..."
        mkdir -p "$(dirname "$key_file")"
        age-keygen -o "$key_file"
        echo "Age key generated at $key_file"
    else
        echo "age-keygen not found. Skipping key generation."
    fi
}

# --- OS-specific main ---

main() {
    echo "=== Package Installation & Setup ==="

    {{ if eq .chezmoi.os "linux" -}}
    install_apt_packages
    install_neovim_linux
    {{ else if eq .chezmoi.os "darwin" -}}
    install_brew_packages
    {{ end -}}

    install_fnm
    install_starship
    install_tpm
    install_age_key

    echo "=== Setup Complete ==="
    echo "NOTE: You may need to restart your shell or source ~/.zshrc"
    echo "For tmux plugins: run 'prefix + I' inside tmux"
}

main "$@"
