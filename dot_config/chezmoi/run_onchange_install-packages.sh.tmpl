#!/bin/bash

set -e
set -o pipefail

# Helper to check if a command exists
command_exists() {
    command -v "$1" >/dev/null 2>&1
}

# --- Package Installation Functions ---

install_apt_packages() {
    echo "Updating apt repositories..."
    sudo apt-get update
    echo "Installing packages from apt.txt..."
    packages=$(cat "{{ .chezmoi.sourceDir }}/packages/apt.txt" | grep -vE "^\s*#|^\s*$" | tr '
' ' ')
    sudo apt-get install -y $packages
}

install_brew_packages() {
    if ! command_exists brew; then
        echo "Homebrew not found. Please install it first from https://brew.sh/"
        exit 1
    fi
    echo "Updating Homebrew..."
    brew update
    echo "Installing packages from brew.txt..."
    packages=$(cat "{{ .chezmoi.sourceDir }}/packages/brew.txt" | grep -vE "^\s*#|^\s*$" | tr '
' ' ')
    brew install $packages
}

install_npm_packages() {
    if ! command_exists npm; then
        echo "npm not found. Please install Node.js first."
        return
    fi
    echo "Installing global npm packages..."
    packages=$(cat "{{ .chezmoi.sourceDir }}/packages/npm.txt" | grep -vE "^\s*#|^\s*$" | tr '
' ' ')
    sudo npm install -g $packages
}

# --- OS Specific Setup ---

setup_debian() {
    echo "Running Debian/Ubuntu setup..."
    install_apt_packages

    # Special case: Install Tree-sitter CLI v0.25.2 for GLIBC compatibility
    echo "Installing/Updating tree-sitter CLI v0.25.2..."
    local ts_path="{{ .chezmoi.homeDir }}/.local/bin/tree-sitter"
    if [ ! -f "$ts_path" ] || [[ ! "$($ts_path --version 2>/dev/null)" == *"0.25.2"* ]]; then
        mkdir -p "{{ .chezmoi.homeDir }}/.local/bin"
        curl -L -o "/tmp/tree-sitter.gz" "https://github.com/tree-sitter/tree-sitter/releases/download/v0.25.2/tree-sitter-linux-x64.gz"
        gunzip -f "/tmp/tree-sitter.gz"
        mv "/tmp/tree-sitter" "$ts_path"
        chmod +x "$ts_path"
        echo "tree-sitter CLI v0.25.2 installed to $ts_path"
    else
        echo "tree-sitter CLI v0.25.2 is already installed."
    fi

    # Install Neovim Nightly AppImage
    if ! command_exists nvim; then
        echo "Installing Neovim Nightly AppImage..."
        local nvim_bin="{{ .chezmoi.homeDir }}/.local/bin/nvim"
        mkdir -p "{{ .chezmoi.homeDir }}/.local/bin"
        curl -L -o "$nvim_bin" https://github.com/neovim/neovim/releases/download/nightly/nvim-linux-x86_64.appimage
        chmod u+x "$nvim_bin"
        
        # Check if FUSE is available, if not, extract the AppImage
        if ! "$nvim_bin" --version >/dev/null 2>&1; then
            echo "FUSE not detected or AppImage failed to run. Extracting as fallback..."
            local old_pwd=$(pwd)
            cd "{{ .chezmoi.homeDir }}/.local/bin"
            ./nvim --appimage-extract >/dev/null
            mv squashfs-root nvim-extracted
            # Create a wrapper script
            cat > nvim <<EOF
#!/bin/bash
{{ .chezmoi.homeDir }}/.local/bin/nvim-extracted/AppRun "\$@"
EOF
            chmod +x nvim
            cd "$old_pwd"
            echo "Neovim installed via extraction."
        fi
    fi

    # Install sops from GitHub
    if ! command_exists sops; then
        echo "Installing sops from GitHub..."
        local sops_version=$(curl -s https://api.github.com/repos/getsops/sops/releases/latest | grep '"tag_name":' | sed -E 's/.*"([^"]+)".*/\1/')
        curl -L -o "{{ .chezmoi.homeDir }}/.local/bin/sops" "https://github.com/getsops/sops/releases/download/${sops_version}/sops-${sops_version}.linux.amd64"
        chmod +x "{{ .chezmoi.homeDir }}/.local/bin/sops"
    fi

    # Ensure age key exists for chezmoi
    local key_file="{{ .chezmoi.homeDir }}/.config/chezmoi/key.txt"
    if [ ! -f "$key_file" ]; then
        echo "Generating age key for chezmoi..."
        mkdir -p "$(dirname "$key_file")"
        age-keygen -o "$key_file"
        echo "Age key generated at $key_file"
        echo "Your public key is: $(grep 'public key:' "$key_file" | cut -d' ' -f4)"
    fi

    install_npm_packages
}

setup_macos() {
    echo "Running macOS setup..."
    install_brew_packages
    install_npm_packages
}

# --- Main Execution ---

echo "Starting package installation..."

{{ if eq .chezmoi.os "linux" -}}
setup_debian
{{ else if eq .chezmoi.os "darwin" -}}
setup_macos
{{ else -}}
echo "Unsupported OS: {{ .chezmoi.os }}"
exit 1
{{ end -}}

# Final post-install actions
if command_exists tmux; then
    # Install tpm if missing
    tpm_dir="{{ .chezmoi.homeDir }}/.tmux/plugins/tpm"
    if [ ! -d "$tpm_dir" ]; then
        echo "Installing tpm..."
        git clone https://github.com/tmux-plugins/tpm "$tpm_dir"
    fi
    
    echo "Installing tmux plugins..."
    # Set the path explicitly to help the installer find where to put things
    export TMUX_PLUGIN_MANAGER_PATH="{{ .chezmoi.homeDir }}/.tmux/plugins/"
    # Run the installer, pointing it to the applied config file
    "$tpm_dir/bin/install_plugins" || echo "Note: some tmux plugins might need a manual 'prefix + I' inside tmux."
fi

echo "Package installation and setup complete!"
