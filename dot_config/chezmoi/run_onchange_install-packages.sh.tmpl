#!/bin/bash
# =============================================================================
# chezmoi run_onchange script: Install packages based on OS
# Triggered whenever chezmoi apply runs
# =============================================================================

# Allow script to continue even if individual commands fail
# set -e  # Disabled - we handle errors manually
# set -o pipefail

# Helper to check if a command exists
command_exists() {
    command -v "$1" >/dev/null 2>&1
}



# --- Package Installation Functions ---

install_apt_packages() {
    echo "Updating apt repositories..."
    sudo apt-get update -qq
    echo "Installing packages from apt.txt..."
    local packages=$(sed -e 's/^#.*//' -e 's/^$/DONE/' "{{ .chezmoi.sourceDir }}/packages/apt.txt" 2>/dev/null | grep -v DONE | tr '\n' ' ')
    if [ -n "$packages" ]; then
        # Try packages in batches, skipping any that fail
        for pkg in $packages; do
            sudo apt-get install -y -qq "$pkg" 2>/dev/null || true
        done
    fi
}

install_brew_packages() {
    if ! command_exists brew; then
        echo "Homebrew not found. Skipping brew packages."
        return
    fi
    echo "Updating Homebrew..."
    brew update -q
    echo "Installing packages from brew.txt..."
    local packages=$(sed -e 's/^#.*//' -e 's/^$/DONE/' "{{ .chezmoi.sourceDir }}/packages/brew.txt" 2>/dev/null | grep -v DONE | tr '\n' ' ')
    if [ -n "$packages" ]; then
        # Try packages individually, skipping any that fail
        for pkg in $packages; do
            brew install -q "$pkg" 2>/dev/null || true
        done
    fi
}

# --- FNM Installation (cross-platform) ---

install_fnm() {
    local fnm_dir="$HOME/.fnm"
    local fnm_exe="$fnm_dir/fnm"

    if command_exists fnm && [ -f "$fnm_exe" ]; then
        echo "FNM already installed."
        return
    fi

    echo "Installing FNM..."
    curl -fsSL https://fnm.vercel.app/install | bash -s -- --install-dir "$fnm_dir" --skip-shell
    echo "FNM installed to $fnm_dir"
}

# --- Starship Installation (cross-platform) ---

install_starship() {
  if command_exists starship; then
    echo "Starship already installed."
    return
  fi

  echo "Installing Starship..."
  # Try the official installer first (requires bash, not sh)
  if timeout 60 bash -c 'curl -sS https://starship.dev/install.sh | bash -s -- -y' 2>/dev/null && command_exists starship; then
    echo "Starship installed via official installer."
    return
  fi

  # Fallback: install directly from GitHub releases
  echo "Official installer failed. Installing from GitHub releases..."
  local arch=$(uname -m)
  local starship_url="https://github.com/starship/starship/releases/latest/download/starship-${arch}-unknown-linux-gnu.tar.gz"
  if curl -fsSL "$starship_url" | tar -xzf - -C /usr/local/bin starship 2>/dev/null; then
    chmod +x /usr/local/bin/starship
    echo "Starship installed from GitHub releases."
  else
    echo "WARNING: Starship installation failed. Install manually: https://starship.rs/"
  fi
}

# --- Neovim on Linux (AppImage) ---

install_neovim_linux() {
    local nvim_bin="{{ .chezmoi.homeDir }}/.local/bin/nvim"
    local nvim_version

    if command_exists nvim; then
        echo "Neovim already installed."
        return
    fi

    echo "Installing Neovim (latest AppImage)..."

    # Try to get latest version or fall back to known stable
    nvim_version=$(curl -sL https://api.github.com/repos/neovim/neovim/releases/latest 2>/dev/null | grep '"tag_name":' | sed -E 's/.*"([^"]+)".*/\1/' || echo "v0.10.0")
    nvim_version=${nvim_version#v}

    mkdir -p "{{ .chezmoi.homeDir }}/.local/bin"

    curl -fsSL -o "$nvim_bin" "https://github.com/neovim/neovim/releases/download/v${nvim_version}/nvim-linux-x86_64.appimage"
    chmod u+x "$nvim_bin"

    # Ensure fusermount is available before trying to run the AppImage.
    # Without it, the AppImage prints a fusermount error to stderr but may still
    # exit with a non-zero code — we check it explicitly so extraction is triggered reliably.
    if ! command -v fusermount3 >/dev/null 2>&1 && ! command -v fusermount >/dev/null 2>&1; then
        echo "fusermount not found. Installing fuse3..."
        if command -v sudo >/dev/null 2>&1; then
            sudo apt-get update -qq 2>/dev/null
            sudo apt-get install -y -qq fuse3 2>/dev/null || sudo apt-get install -y -qq fuse 2>/dev/null
        fi
    fi

    # Try running the AppImage directly (requires FUSE kernel module + fusermount)
    local appimage_output
    appimage_output=$("$nvim_bin" --version 2>&1)
    local appimage_exit=$?

    if [ $appimage_exit -eq 0 ] && echo "$appimage_output" | grep -qi "NVIM"; then
        echo "Neovim AppImage running via FUSE: $($nvim_bin --version | head -1)"
    else
        echo "FUSE not usable (exit $appimage_exit). Extracting AppImage..."
        if echo "$appimage_output" | grep -qi "fusermount"; then
            echo "(hint: $appimage_output)"
        fi

        local old_pwd=$PWD
        cd "{{ .chezmoi.homeDir }}/.local/bin"

        local extract_error
        extract_error=$("$nvim_bin" --appimage-extract 2>&1) && true

        if [ -d "squashfs-root" ]; then
            rm -rf "nvim-extracted"
            mv squashfs-root nvim-extracted
            chmod +x nvim-extracted/AppRun
            # Replace the AppImage with a wrapper that calls the extracted binary
            printf '#!/bin/bash\nexec "%s/.local/bin/nvim-extracted/AppRun" "$@"\n' "$HOME" > "{{ .chezmoi.homeDir }}/.local/bin/nvim"
            chmod +x "{{ .chezmoi.homeDir }}/.local/bin/nvim"
            echo "Neovim extracted to nvim-extracted/"
        else
            echo "ERROR: AppImage extraction failed."
            echo "Output was: $extract_error"
            echo "Downloaded file may be corrupt. Try: rm $nvim_bin && re-run bootstrap."
            return 1
        fi

        cd "$old_pwd"
    fi

    echo "Neovim installed to $nvim_bin"
}

# --- Neovim on macOS (official tarball from GitHub) ---
#
# Homebrew's neovim bottle lags behind the latest stable release by 1-2 patch versions.
# Instead, download the official Neovim release tarball directly from GitHub — same pattern
# used for Linux AppImages.

install_neovim_darwin() {
    local nvim_version
    local arch
    local nvim_arch
    local tmp_dir="{{ .chezmoi.homeDir }}/.local/bin"
    local archive="$tmp_dir/nvim-macos.tar.gz"
    local extracted_dir

    if command_exists nvim; then
        echo "Neovim already installed."
        return
    fi

    echo "Installing Neovim (latest) for macOS..."

    arch=$(uname -m)
    if [ "$arch" = "arm64" ]; then
        nvim_arch="arm64"
    else
        nvim_arch="x86_64"
    fi

    nvim_version=$(curl -sL https://api.github.com/repos/neovim/neovim/releases/latest 2>/dev/null | grep '"tag_name":' | sed -E 's/.*"([^"]+)".*/\1/' || echo "v0.10.0")
    nvim_version=${nvim_version#v}
    echo "Latest stable: v$nvim_version"

    mkdir -p "$tmp_dir"

    curl -fsSL -o "$archive" \
        "https://github.com/neovim/neovim/releases/download/v${nvim_version}/nvim-macos-${nvim_arch}.tar.gz"

    tar -xzf "$archive" -C "$tmp_dir"
    rm -f "$archive"

    # The tarball extracts to nvim-macos-<arch>/ — the bin directory is inside that
    extracted_dir="$tmp_dir/nvim-macos-${nvim_arch}"

    if [ -d "$extracted_dir/bin" ]; then
        # Create a wrapper that prepends the bundle's bin to PATH (so bundled tools
        # like lazy.nvim's downloader can find themselves) then execs the real nvim.
        printf '#!/bin/bash\nexport PATH="%s/bin:$PATH"\nexec "%s/bin/nvim" "$@"\n' \
            "$extracted_dir" "$extracted_dir" > "$tmp_dir/nvim"
        chmod +x "$tmp_dir/nvim"
        echo "Neovim installed to $tmp_dir/nvim (wrapper to $extracted_dir/bin/nvim)"
    else
        echo "ERROR: extraction failed — nvim-macos-${nvim_arch}/bin not found"
        return 1
    fi
}

# --- TPM (Tmux Plugin Manager) Installation ---

install_tpm() {
    local tpm_dir="{{ .chezmoi.homeDir }}/.tmux/plugins/tpm"

    if [ -d "$tpm_dir" ]; then
        echo "TPM already installed."
        return
    fi

    echo "Installing TPM..."
    git clone -q https://github.com/tmux-plugins/tpm "$tpm_dir"
}

# --- Age Key for Chezmoi ---
#
# Uses the official 'chezmoi age-keygen' command (built into chezmoi) to generate
# the age identity. Then auto-populates the 'recipient' field in chezmoi.toml
# with the generated public key.
#
# After bootstrap, chezmoi apply will be able to decrypt all .age files.

install_age_key() {
    local key_file="{{ .chezmoi.homeDir }}/.config/chezmoi/key.txt"
    local chezmoi_toml="{{ .chezmoi.homeDir }}/.config/chezmoi/chezmoi.toml"

    if [ -f "$key_file" ]; then
        echo "Age key already exists at $key_file"
    else
        if command -v chezmoi >/dev/null 2>&1; then
            echo "Generating age key with chezmoi age-keygen..."
            mkdir -p "$(dirname "$key_file")"
            # chezmoi age-keygen outputs to --output path and prints public key to stdout
            local pubkey
            pubkey=$(chezmoi age-keygen --output="$key_file" 2>/dev/null)
            if [ -f "$key_file" ]; then
                echo "Age key generated at $key_file"

                # Auto-populate 'recipient' in chezmoi.toml if it has the placeholder
                if [ -f "$chezmoi_toml" ] && grep -q 'REPLACE_WITH_YOUR_AGE_PUBLIC_KEY' "$chezmoi_toml" 2>/dev/null; then
                    # Extract public key from the generated identity file
                    # age identity files have format: AGE IDENTITY 1\n<private_key>\n\nPublic key: age1...\n
                    local actual_pubkey
                    actual_pubkey=$(grep '^Public key:' "$key_file" 2>/dev/null | sed 's/^Public key: *//')
                    if [ -n "$actual_pubkey" ]; then
                        sed -i "s/REPLACE_WITH_YOUR_AGE_PUBLIC_KEY/$actual_pubkey/" "$chezmoi_toml"
                        echo "Auto-filled 'recipient' in chezmoi.toml with public key: $actual_pubkey"
                    else
                        echo "WARNING: Could not extract public key from $key_file"
                        echo "Please manually replace 'REPLACE_WITH_YOUR_AGE_PUBLIC_KEY' in $chezmoi_toml"
                    fi
                fi
            else
                echo "WARNING: chezmoi age-keygen failed. Install age manually."
            fi
        else
            echo "WARNING: chezmoi not found. Cannot generate age key."
            echo "Install chezmoi first, then run: chezmoi age-keygen --output=$key_file"
        fi
    fi
}

# --- OS-specific main ---

main() {
    echo "=== Package Installation & Setup ==="

    {{ if eq .chezmoi.os "linux" -}}
    install_apt_packages
    install_neovim_linux
    {{ else if eq .chezmoi.os "darwin" -}}
    install_brew_packages
    install_neovim_darwin
    {{ end -}}

    install_fnm
    install_starship
    install_tpm
    install_age_key

    echo "=== Setup Complete ==="
    echo "NOTE: You may need to restart your shell or source ~/.zshrc"
    echo "For tmux plugins: run 'prefix + I' inside tmux"
}

main "$@"
