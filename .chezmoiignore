# chezmoiignore — exclude non-dotfile files from chezmoi management
# chezmoi installs everything by default, so we list what to IGNORE.

# Non-dotfile project files
README.md
AGENTS.md
.task/
DOTFILES_STRATEGY.md
bootstrap.sh
macos_on_incus_potential_solution.txt

# Tests and docs (not deployed to home)
tests/
DOCS/
macos-scripts/

# Test artifacts (never deploy)
private_dot_ssh/test_roundtrip_key.age
private_dot_ssh/encrypted_private_test_roundtrip_key.age
private_dot_ssh/test_wrapper_key.age
private_dot_ssh/encrypted_private_test_wrapper_key.age

# Themes (not deployed as dotfiles)
themes/

# Template source files (already managed by chezmoi)
{{ if ne .chezmoi.os "darwin" }}
# Exclude macOS-only configs on non-macOS
dot_config/skhd/skhdrc
{{ end }}

# ── Encrypted files: ignore when age identity is absent ──
# Without the identity file, chezmoi can't decrypt .age files. Ignoring them
# lets config apply work normally for all unencrypted files. Place the key
# at ~/.config/chezmoi/key.txt and run 'config apply' (or 'config unlock')
# to decrypt on-demand.
{{- $hasKey := stat (joinPath .chezmoi.homeDir ".config" "chezmoi" "key.txt") }}
{{- if not $hasKey }}
**/*.age
{{- end }}
