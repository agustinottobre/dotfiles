sourceDir = "{{ .chezmoi.sourceDir }}"
encryption = "age"
[age]
    # Path to the private key identity file (generated by bootstrap.sh)
    identity = "{{ .chezmoi.homeDir }}/.config/chezmoi/key.txt"

    # Placeholder replaced by bootstrap.sh after chezmoi init via sed.
    # Uses 'chezmoi age-keygen -y' to extract the public key.
    recipient = "REPLACE_WITH_YOUR_AGE_PUBLIC_KEY"
