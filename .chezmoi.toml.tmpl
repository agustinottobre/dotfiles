sourceDir = "{{ .chezmoi.sourceDir }}"
encryption = "age"
[age]
    # Path to the private key identity file (generated by 'chezmoi age-keygen')
    identity = "{{ .chezmoi.homeDir }}/.config/chezmoi/key.txt"

    # ============================================================
    # IMPORTANT: You MUST fill in your public key below.
    # After running 'bootstrap.sh', generate your key with:
    #
    #   chezmoi age-keygen --output=$HOME/.config/chezmoi/key.txt
    #
    # The output will show your public key (age1...). Copy it below.
    # ============================================================
    recipient = "REPLACE_WITH_YOUR_AGE_PUBLIC_KEY"
