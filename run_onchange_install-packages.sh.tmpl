{{ if hasKey . "packages" }}{{ if eq .chezmoi.os "linux" }}#!/bin/bash
# Package list hash: {{ include ".chezmoidata/packages.yaml" | sha256sum }}

# Error tracking
FAILED=0
check_fail() {
  if [ $? -ne 0 ]; then
    echo "  ✗ FAILED: $1" >&2
    FAILED=$((FAILED + 1))
  else
    echo "  ✓ OK: $1"
  fi
}

# ── System packages (apt) ──────────────────────────────────────────────────
echo "=== Installing system packages ==="
sudo apt-get update -qq 2>/tmp/apt-errors.log
check_fail "apt-get update"
{{ range .packages.linux.apt -}}
sudo apt-get install -y -qq {{ . | quote }} 2>/tmp/apt-errors.log
check_fail "apt-get install: {{ . }}"
{{ end -}}

# ── FNM (Node version manager) ─────────────────────────────────────────────
if ! command -v fnm >/dev/null 2>&1; then
    echo "Installing FNM..."
    if curl -fsSL https://fnm.vercel.app/install | bash -s -- --install-dir "{{ .chezmoi.homeDir }}/.fnm" --skip-shell; then
        echo "  ✓ FNM installed"
    else
        echo "  ✗ FAILED: FNM install" >&2
        FAILED=$((FAILED + 1))
    fi
fi

# ── Starship prompt ─────────────────────────────────────────────────────────
if ! command -v starship >/dev/null 2>&1; then
    echo "Installing Starship..."
    if timeout 60 bash -c 'curl -sS https://starship.dev/install.sh | bash -s -- -y' 2>/dev/null; then
        echo "  ✓ Starship installed (via install.sh)"
    else
        echo "  Starship install.sh failed, trying direct download..."
        curl -fsSL "https://github.com/starship/starship/releases/latest/download/starship-$(uname -m)-unknown-linux-gnu.tar.gz" 2>/dev/null | tar -xzf - -C /usr/local/bin starship 2>/dev/null && chmod +x /usr/local/bin/starship 2>/dev/null
        if command -v starship >/dev/null 2>&1; then
            echo "  ✓ Starship installed (via direct download)"
        else
            echo "  ✗ FAILED: Starship install" >&2
            FAILED=$((FAILED + 1))
        fi
    fi
fi

# ── Neovim (nightly AppImage) ──────────────────────────────────────────────
install_neovim() {
    local nvim_bin="{{ .chezmoi.homeDir }}/.local/bin/nvim"
    if [ -x "{{ .chezmoi.homeDir }}/.local/bin/nvim" ] && "{{ .chezmoi.homeDir }}/.local/bin/nvim" --headless -c 'quit' 2>/dev/null; then return 0; fi
    echo "Installing Neovim (nightly)..."
    mkdir -p "$(dirname "$nvim_bin")" || true
    curl -fsSL -o "$nvim_bin" "https://github.com/neovim/neovim/releases/download/nightly/nvim-linux-x86_64.appimage" || return 0
    chmod u+x "$nvim_bin" || true
    if ! command -v fusermount3 >/dev/null 2>&1 && ! command -v fusermount >/dev/null 2>&1; then
        sudo apt-get install -y -qq fuse3 2>/dev/null || sudo apt-get install -y -qq fuse 2>/dev/null || true
    fi
    if ! "$nvim_bin" --version >/dev/null 2>&1; then
        (cd "$(dirname "$nvim_bin")" && "$nvim_bin" --appimage-extract 2>/dev/null && {
            rm -rf nvim-extracted; mv squashfs-root nvim-extracted
            printf '#!/bin/bash\nexec "%s/.local/bin/nvim-extracted/AppRun" "$@"\n' "{{ .chezmoi.homeDir }}" > "$nvim_bin"
            chmod +x "$nvim_bin"
        }) || true
    fi
}
install_neovim
NVIM_BIN="{{ .chezmoi.homeDir }}/.local/bin/nvim"
if [ -x "$NVIM_BIN" ] && "$NVIM_BIN" --headless -c 'quit' 2>/dev/null; then
    echo "  ✓ Neovim installed"
else
    echo "  ✗ FAILED: Neovim install" >&2
    FAILED=$((FAILED + 1))
fi

# ── TPM (Tmux Plugin Manager) ──────────────────────────────────────────────
if [ ! -d "{{ .chezmoi.homeDir }}/.tmux/plugins/tpm" ]; then
    echo "Installing TPM..."
    if git clone -q https://github.com/tmux-plugins/tpm "{{ .chezmoi.homeDir }}/.tmux/plugins/tpm"; then
        echo "  ✓ TPM installed"
    else
        echo "  ✗ FAILED: TPM install" >&2
        FAILED=$((FAILED + 1))
    fi
fi

# ── Age key ─────────────────────────────────────────────────────────────────
KEY_FILE="{{ .chezmoi.homeDir }}/.config/chezmoi/key.txt"
CHEZMOI_TOML="{{ .chezmoi.homeDir }}/.config/chezmoi/chezmoi.toml"
if [ ! -f "$KEY_FILE" ]; then
    echo "Generating age key..."
    mkdir -p "$(dirname "$KEY_FILE")" || true
    chezmoi age-keygen --output="$KEY_FILE" 2>/dev/null || true
fi
if [ -f "$CHEZMOI_TOML" ] && [ -f "$KEY_FILE" ] && grep -q 'REPLACE_WITH_YOUR_AGE_PUBLIC_KEY' "$CHEZMOI_TOML" 2>/dev/null; then
    PUBKEY=$(grep 'public key:' "$KEY_FILE" 2>/dev/null | sed 's/.*public key: *//')
    if [ -n "$PUBKEY" ]; then
        if [ "$(uname -s)" = "Darwin" ]; then
            sed -i "" "s/REPLACE_WITH_YOUR_AGE_PUBLIC_KEY/$PUBKEY/" "$CHEZMOI_TOML"
        else
            sed -i "s/REPLACE_WITH_YOUR_AGE_PUBLIC_KEY/$PUBKEY/" "$CHEZMOI_TOML"
        fi
    fi
fi

# ── Chezmoi zsh completions ────────────────────────────────────────────────
COMP_DIR="/usr/local/share/zsh/site-functions"
if [ ! -f "$COMP_DIR/_chezmoi" ]; then
    echo "Installing chezmoi completions..."
    mkdir -p "$COMP_DIR" || true
    chezmoi completion zsh > "$COMP_DIR/_chezmoi" 2>/dev/null || true
fi

echo "============================================"
echo "  Package Installation Summary"
echo "============================================"
if [ $FAILED -eq 0 ]; then
    echo "  ✓ All packages installed successfully."
else
    echo "  ⚠ $FAILED package(s) failed to install. Check output above for details."
fi
echo ""

echo "=== Setup Complete ==="

