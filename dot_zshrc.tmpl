# Dotfiles management (chezmoi)
function config(){
  if [[ $# == 0 ]]
  then
    # Fuzzy-find and edit a managed dotfile
    if ! command -v fzf >/dev/null 2>&1; then
      echo "config: fzf is required but not installed." >&2
      return 1
    fi
    local f
    f=$(chezmoi managed 2>/dev/null | fzf --height 40% --layout=reverse) || return 1
    [[ -n "$f" ]] && chezmoi edit "$HOME/$f"
    elif [[ "$1" == "lock" ]]; then
      _config_lock
    elif [[ "$1" == "unlock" ]]; then
      _config_unlock
    elif [[ "$1" == "rotate-key" ]]; then
      shift
      _config_rotate "$@"
    else
    # Passthrough to chezmoi
    if ! chezmoi source-path >/dev/null 2>&1; then
      echo "config: chezmoi source directory not found. Run bootstrap.sh first." >&2
      return 1
    fi
    chezmoi "$@"
  fi
}

# ── Secure removal helper ───────────────────────────────────────────────────
_config_rm() {
    if command -v shred >/dev/null 2>&1; then
        shred -u "$1" 2>/dev/null || rm -f "$1"
    else
        rm -f "$1"
    fi
}

# ── config lock / unlock ────────────────────────────────────────────────────
# lock   → removes deployed secrets (key.txt.age stays for next unlock)
# unlock → passphrase (or manual key) → deploy secrets → shred plaintext key

_config_lock() {
    local target srcpath removed=0
    chezmoi source-path >/dev/null 2>&1 || { echo "config lock: chezmoi not configured" >&2; return 1; }
    while IFS= read -r target; do
        [[ -n "$target" ]] || continue
        srcpath=$(chezmoi source-path "$HOME/$target" 2>/dev/null) || continue
        if [[ "$srcpath" == *.age ]]; then
            rm -f "$HOME/$target" && ((removed++))
        fi
    done < <(chezmoi managed 2>/dev/null)
    echo "config lock: removed ${removed} encrypted file(s)"
}

_config_unlock() {
    local protected=~/.config/chezmoi/key.txt.age
    local key=~/.config/chezmoi/key.txt

    if [[ -f "$protected" ]]; then
        echo "Enter passphrase to unlock:"
        chezmoi age decrypt --passphrase --output "$key" "$protected" || return 1
        chmod 600 "$key"
    elif [[ -f "$key" ]]; then
        config apply
        echo ""
        echo "Choose a passphrase to protect your key locally (Enter to skip):"
        if chezmoi age encrypt --passphrase --output "$protected" "$key" 2>/dev/null; then
            echo "  ✓ Key protected at $protected"
        else
            echo "  ⚠ Passphrase skipped — place key manually on next unlock"
        fi
        _config_rm "$key"
        echo "config unlock: secrets deployed"
        return 0
    else
        echo "config unlock: no key found" >&2
        echo "  Place your age key at $key, then re-run." >&2
        return 1
    fi
    config apply
    _config_rm "$key"
    echo "config unlock: secrets deployed"
}

# ── config rotate-key ───────────────────────────────────────────────────────
# Re-encrypts all .age files with a new key and updates chezmoi.toml.
# Usage: config rotate-key ~/new-age-key.txt
_config_rotate() {
    local new_key_path="$1"
    local old_key=~/.config/chezmoi/key.txt
    local protected=~/.config/chezmoi/key.txt.age

    if [[ $# -ne 1 || ! -f "$new_key_path" ]]; then
        echo "Usage: config rotate-key <new-key-file>" >&2
        return 1
    fi

    # ── 1. Get the old key ──
    if [[ -f "$old_key" ]]; then
        echo "Old key: $old_key"
    elif [[ -f "$protected" ]]; then
        echo "Old key protected — enter passphrase:"
        chezmoi age decrypt --passphrase --output "$old_key" "$protected" || return 1
        chmod 600 "$old_key"
    else
        echo "Old key not found at $old_key or $protected" >&2
        return 1
    fi

    # ── 2. Extract new public key ──
    local new_pubkey
    new_pubkey=$(chezmoi age-keygen -y "$new_key_path" 2>/dev/null)
    if [[ -z "$new_pubkey" ]]; then
        echo "Could not extract public key from $new_key_path" >&2
        return 1
    fi
    echo "New key:  $new_key_path"
    echo "New pub:  $new_pubkey"
    echo ""

    # ── 3. Re-encrypt each .age file ──
    local src rotated=0
    src=$(chezmoi source-path 2>/dev/null) || { echo "chezmoi not configured" >&2; return 1; }
    while IFS= read -r -d '' agefile; do
        local rel="${agefile#$src/}"
        [[ "$rel" == "key.txt.age" ]] && continue
        local tmp=$(mktemp /tmp/chezmoi-rotate-XXXXXX)
        if age -d -i "$old_key" "$agefile" 2>/dev/null | age -r "$new_pubkey" -o "$tmp" 2>/dev/null; then
            mv "$tmp" "$agefile" && ((rotated++))
            echo "  ✓ $rel"
        else
            rm -f "$tmp"
            echo "  ✗ $rel — skipped" >&2
        fi
    done < <(find "$src" -name '*.age' -type f -print0 2>/dev/null)

    # ── 4. Update chezmoi.toml recipient ──
    local toml=~/.config/chezmoi/chezmoi.toml
    if [[ -f "$toml" ]]; then
        if [[ "$(uname -s)" == "Darwin" ]]; then
            sed -i '' "s|recipient.*=.*\"age1[^\"]*\"|recipient = \"$new_pubkey\"|" "$toml"
        else
            sed -i "s|recipient.*=.*\"age1[^\"]*\"|recipient = \"$new_pubkey\"|" "$toml"
        fi
        echo ""
        echo "  ✓ chezmoi.toml recipient updated"
    fi

    # ── 5. Summary ──
    echo ""
    echo "── Rotation complete: ${rotated} file(s) re-encrypted ──"
    echo "  Review:  config diff"
    echo "  Commit:  config commit -m 'rotate: age master key' && config git -- push"
    echo "  Old key: still on disk at $old_key (run 'config lock' to secure)"
    echo "  New key: $new_key_path (distribute to other machines)"
}

# Wiki
function wiki-list-select(){
  local wiki=$HOME/wiki
  local wiki_work=$HOME/wiki_work

  for DIR in $wiki $wiki_work
  do
    [[ -d "$DIR" ]] && if [ $(isDirEmpty "$DIR") -eq 0 ]
    then
      if [ -z $wiki_list ]
      then
       local wiki_list=$DIR
      else
       local wiki_list=$wiki_list"\n"$DIR
      fi
    fi
  done
  echo $wiki_list | fzf --select-1
}

function isDirEmpty(){
  DIR=$1
  if [ "$(ls -A $DIR)" ]; then
    echo 0
  else
    echo 1
  fi
}

function wiki(){
  local wiki_selected=$(wiki-list-select)
  if [[ -z "$wiki_selected" ]]; then
    echo "wiki: No wiki directory found. Create ~/wiki or ~/wiki_work first." >&2
    return 1
  fi
  if [[ $# == 0 ]]
  then
    vim $wiki_selected/index.md
  else
    git -C $wiki_selected ${@:1}
  fi
}

# Git functions
function git-remote-url(){
 local rmt=$1; shift || return 1
 local url
 url=`git config --get remote.${rmt}.url`
 [[ "$url" == git@* ]] && { url="https://github.com/${url##*:}" >&2; } || { url="${url%%.git}" >&2; };
 printf "%s\n" "$url"
}

function git-branch-select(){
  git branch | fzf -q '*' | cut -c3-
}

function git-current-branch(){
  git rev-parse --abbrev-ref HEAD
}

function git-remote-select(){
  git remote | fzf --select-1
}

# Find grep
ft () {
  if [[ -d "$1" && "" != $2 ]] ; then
    find $1 -name "*" | xargs fgrep $2 2>/dev/null
  else
    echo "Usage: findgrep <PATH> <TEXT_TO_FIND>"
  fi
}

# Extract archives
extract () {
   if [ -f "$1" ] ; then
       case $1 in
           *.tar.bz2)   tar xvjf -- "$1"    ;;
           *.tar.gz)    tar xvzf -- "$1"    ;;
           *.bz2)       bunzip2 -- "$1"     ;;
           *.rar)       unrar x -- "$1"     ;;
           *.gz)        gunzip -- "$1"      ;;
           *.tar)       tar xvf -- "$1"     ;;
           *.tbz2)      tar xvjf -- "$1"    ;;
           *.tgz)       tar xvzf -- "$1"    ;;
           *.zip)       unzip -- "$1"       ;;
           *.Z)         uncompress -- "$1"  ;;
           *.7z)        7z x -- "$1"        ;;
           *)           echo "don't know how to extract '$1'..." ;;
       esac
   else
       echo "'$1' is not a valid file"
   fi
}

# Epoch conversion
epoch() {
  if [[ "$1" =~ '^[0-9]{10}$' ]]; then
    # Unix timestamp → human-readable
    {{- if eq .chezmoi.os "darwin" }}
    date -r "$1"
    {{- else }}
    date -d "@$1"
    {{- end }}
  else
    # Human-readable → Unix timestamp
    if [ $# -gt 0 ]; then
      {{- if eq .chezmoi.os "darwin" }}
      date -j -f "%F %T" "$*" +%s 2>/dev/null || date +%s
      {{- else }}
      date +%s --date="$*"
      {{- end }}
    else
      date +%s
    fi
  fi
}

# Command result indicator
function command_result (){
    if [ $? = 0 ]; then
        echo -ne "${GREEN_HI}[OK]${NC}";
    else
        echo -ne "${RED_HI}[NO]${NC}";
    fi
}

# Diff sorted
function diffs() {
    diff  <(sort $1) <(sort $2)
}

