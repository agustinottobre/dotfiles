# =============================================================================
# ZIM + Starship Configuration
# Pure zsh setup (no shell_profile)
# =============================================================================

ZIM_HOME=${ZDOTDIR:-${HOME}}/.zim

if [[ ! -e ${ZIM_HOME}/zimfw.zsh ]]; then
  if (( ${+commands[curl]} )); then
    curl -fsSL --create-dirs -o ${ZIM_HOME}/zimfw.zsh \
        https://github.com/zimfw/zimfw/releases/latest/download/zimfw.zsh
  else
    mkdir -p ${ZIM_HOME} && wget -nv -O ${ZIM_HOME}/zimfw.zsh \
        https://github.com/zimfw/zimfw/releases/latest/download/zimfw.zsh
  fi
fi

if [[ ! ${ZIM_HOME}/init.zsh -nt ${ZIM_CONFIG_FILE:-${ZDOTDIR:-${HOME}}/.zimrc} ]]; then
  source ${ZIM_HOME}/zimfw.zsh init
fi

source ${ZIM_HOME}/init.zsh

# =============================================================================
# Completions & FZF (must be sourced early)
# =============================================================================

# Source FZF keybindings
# Homebrew (macOS): ~/.fzf.zsh — checked first, covers all Homebrew installs
# Linux: various system paths checked as fallback
# macOS non-Homebrew: Intel Mac Homebrew share dir, MacPorts, Apple Silicon Homebrew
if [[ -f ~/.fzf.zsh ]]; then
  source ~/.fzf.zsh
{{- if eq .chezmoi.os "linux" }}
elif [[ -f /usr/share/fzf/key-bindings.zsh ]]; then
  source /usr/share/fzf/key-bindings.zsh
elif [[ -f /usr/share/doc/fzf/examples/key-bindings.zsh ]]; then
  source /usr/share/doc/fzf/examples/key-bindings.zsh
{{- else }}
# macOS non-Homebrew fallback paths (Intel Mac Homebrew, MacPorts, Apple Silicon Homebrew)
elif [[ -f /usr/local/opt/fzf/share/fzf/key-bindings.zsh ]]; then
  source /usr/local/opt/fzf/share/fzf/key-bindings.zsh
elif [[ -f /opt/homebrew/share/fzf/key-bindings.zsh ]]; then
  source /opt/homebrew/share/fzf/key-bindings.zsh
#elif [[ -f /opt/local/share/fzf/key-bindings.zsh ]]; then
#  source /opt/local/share/fzf/key-bindings.zsh
{{- end }}
fi

# Explicitly bind fzf keys (ensures they work if overridden elsewhere)
# zle -la checks all widgets including autoloaded (macOS fpath autoload)
if zle -la fzf-file-widget >/dev/null 2>&1; then
  bindkey '^X^F' fzf-file-widget
  bindkey '^R' fzf-history-widget
  bindkey '^T' fzf-file-widget
fi

{{- if eq .chezmoi.os "darwin" }}
# Dart completion
[[ -f $HOME/.dart-cli-completion/zsh-config.zsh ]] && . $HOME/.dart-cli-completion/zsh-config.zsh || true
{{- end }}

