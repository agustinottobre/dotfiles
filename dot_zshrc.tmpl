# =============================================================================
# Functions
# =============================================================================

# Dotfiles management (chezmoi)
function config(){
  if [[ $# == 0 ]]
  then
    # Fuzzy-find and edit a managed dotfile
    if ! command -v fzf >/dev/null 2>&1; then
      echo "config: fzf is required but not installed." >&2
      return 1
    fi
    local f
    f=$(chezmoi managed 2>/dev/null | fzf --height 40% --layout=reverse) || return 1
    [[ -n "$f" ]] && chezmoi edit "$HOME/$f"
  elif [[ "$1" == "lock" ]]; then
    # Lock: remove deployed SSH keys + age identity
    _config_lock
  elif [[ "$1" == "unlock" ]]; then
    # Unlock: temporarily place age key, apply, remove key
    _config_unlock
  else
    # Passthrough to chezmoi
    if ! chezmoi source-path >/dev/null 2>&1; then
      echo "config: chezmoi source directory not found. Run bootstrap.sh first." >&2
      return 1
    fi
    chezmoi "$@"
  fi
}

# ── config lock / unlock internals ──
# Without the age identity file at ~/.config/chezmoi/key.txt, encrypted
# .age files are ignored via .chezmoiignore — deployed targets stay empty.
# Place the key at ~/.config/chezmoi/key.txt (from primary machine) and run
# 'config unlock' to deploy secrets temporarily.
_config_unlock() {
    if [[ ! -f ~/.config/chezmoi/key.txt ]]; then
        echo "config unlock: age key not found at ~/.config/chezmoi/key.txt" >&2
        echo "  Place your key there first (copy from primary machine or password manager)" >&2
        return 1
    fi
    config apply
    rm -f ~/.config/chezmoi/key.txt
    echo "config unlock: encrypted files deployed, identity removed from disk"
}

_config_lock() {
    local src target srcpath removed
    src=$(chezmoi source-path 2>/dev/null) || { echo "config lock: chezmoi not configured" >&2; return 1; }
    removed=0
    while IFS= read -r target; do
        [[ -n "$target" ]] || continue
        srcpath=$(chezmoi source-path "$HOME/$target" 2>/dev/null) || continue
        if [[ "$srcpath" == *.age ]]; then
            rm -f "$HOME/$target" && ((removed++))
        fi
    done < <(chezmoi managed 2>/dev/null)
    rm -f ~/.config/chezmoi/key.txt
    echo "config lock: removed ${removed} encrypted file(s), age identity deleted"
}

# Wiki
function wiki-list-select(){
  local wiki=$HOME/wiki
  local wiki_work=$HOME/wiki_work

  for DIR in $wiki $wiki_work
  do
    [[ -d "$DIR" ]] && if [ $(isDirEmpty "$DIR") -eq 0 ]
    then
      if [ -z $wiki_list ]
      then
       local wiki_list=$DIR
      else
       local wiki_list=$wiki_list"\n"$DIR
      fi
    fi
  done
  echo $wiki_list | fzf --select-1
}

function isDirEmpty(){
  DIR=$1
  if [ "$(ls -A $DIR)" ]; then
    echo 0
  else
    echo 1
  fi
}

function wiki(){
  local wiki_selected=$(wiki-list-select)
  if [[ -z "$wiki_selected" ]]; then
    echo "wiki: No wiki directory found. Create ~/wiki or ~/wiki_work first." >&2
    return 1
  fi
  if [[ $# == 0 ]]
  then
    vim $wiki_selected/index.md
  else
    git -C $wiki_selected ${@:1}
  fi
}

# Git functions
function git-remote-url(){
 local rmt=$1; shift || return 1
 local url
 url=`git config --get remote.${rmt}.url`
 [[ "$url" == git@* ]] && { url="https://github.com/${url##*:}" >&2; } || { url="${url%%.git}" >&2; };
 printf "%s\n" "$url"
}

function git-branch-select(){
  git branch | fzf -q '*' | cut -c3-
}

function git-current-branch(){
  git rev-parse --abbrev-ref HEAD
}

function git-remote-select(){
  git remote | fzf --select-1
}

# Find grep
ft () {
  if [[ -d "$1" && "" != $2 ]] ; then
    find $1 -name "*" | xargs fgrep $2 2>/dev/null
  else
    echo "Usage: findgrep <PATH> <TEXT_TO_FIND>"
  fi
}

# Extract archives
extract () {
   if [ -f "$1" ] ; then
       case $1 in
           *.tar.bz2)   tar xvjf -- "$1"    ;;
           *.tar.gz)    tar xvzf -- "$1"    ;;
           *.bz2)       bunzip2 -- "$1"     ;;
           *.rar)       unrar x -- "$1"     ;;
           *.gz)        gunzip -- "$1"      ;;
           *.tar)       tar xvf -- "$1"     ;;
           *.tbz2)      tar xvjf -- "$1"    ;;
           *.tgz)       tar xvzf -- "$1"    ;;
           *.zip)       unzip -- "$1"       ;;
           *.Z)         uncompress -- "$1"  ;;
           *.7z)        7z x -- "$1"        ;;
           *)           echo "don't know how to extract '$1'..." ;;
       esac
   else
       echo "'$1' is not a valid file"
   fi
}

# Epoch conversion
epoch() {
  if [[ "$1" =~ '^[0-9]{10}$' ]]; then
    # Unix timestamp → human-readable
    {{- if eq .chezmoi.os "darwin" }}
    date -r "$1"
    {{- else }}
    date -d "@$1"
    {{- end }}
  else
    # Human-readable → Unix timestamp
    if [ $# -gt 0 ]; then
      {{- if eq .chezmoi.os "darwin" }}
      date -j -f "%F %T" "$*" +%s 2>/dev/null || date +%s
      {{- else }}
      date +%s --date="$*"
      {{- end }}
    else
      date +%s
    fi
  fi
}

# Command result indicator
function command_result (){
    if [ $? = 0 ]; then
        echo -ne "${GREEN_HI}[OK]${NC}";
    else
        echo -ne "${RED_HI}[NO]${NC}";
    fi
}

# Diff sorted
function diffs() {
    diff  <(sort $1) <(sort $2)
}

{{- if eq .chezmoi.os "darwin" }}
# k3d config (macOS/rancher-desktop)
function k3dconfigwall(){
  k3d cluster list --no-headers -o string | cut -d' ' -f1 | xargs k3d kubeconfig write
}

# Kubernetes config
function kubeconfigRefresh() {
  local kube_dirs=()
  [[ -d "$HOME/.kube" ]] && kube_dirs+=("$HOME/.kube")
  [[ -d "$HOME/.config/k3d" ]] && kube_dirs+=("$HOME/.config/k3d")
  if [[ ${#kube_dirs[@]} -gt 0 ]]; then
    export KUBECONFIG=$(find "${kube_dirs[@]}" -name "config*" -o -name "kubeconfig*" | awk '{printf "%s:", $0} END {print ""}')
  fi
}
kubeconfigRefresh
{{- end }}

# Dev builds
function list-dev-builds(){
  if [[ $# == 0 ]]
  then
    echo "Usage: list-dev-builds <PATH> <MAXDEPTH>"
    return -1
  fi
  find $1 -maxdepth $2 -type d \( -name "build" -o -name "node_modules" -o -name ".nx" -o -name ".next" -o -name "dist" \)
}

# RandMAC
function randmac() {
  openssl rand -hex 6 | sed 's/\(..\)/\1:/g; s/.$//'
}

# =============================================================================
# Lazy Loaded Tools
# =============================================================================

# FNM (Node Version Manager)
fnm() {
  unset -f fnm
  # Add FNM to PATH if not already present
  [[ ":$PATH:" != *":$FNM_DIR:"* ]] && export PATH="$FNM_DIR:$PATH"
  # Initialize FNM shell environment
  eval "$(fnm env)" 2>/dev/null
  fnm "$@"
}

# SDKMAN (Java/Rust toolchain manager)
sdk() {
  unset -f sdk
  export SDKMAN_DIR="$HOME/.sdkman"
  source "$HOME/.sdkman/bin/sdkman-init.sh"
  sdk "$@"
}

