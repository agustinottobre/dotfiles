#!/usr/bin/env zsh
# =============================================================================
# Zsh Environment - sourced for all shell types
# =============================================================================

# FPATH in the environment (e.g. inherited from bash or parent process) will
# replace zsh's compiled-in default fpath, dropping essential functions like
# is-at-least that Zim requires. Unset it to restore the defaults.
unset FPATH
{{- if eq .chezmoi.os "linux" }}
# On Linux, also ensure the system zsh function dirs are explicitly in fpath
# in case the compiled-in defaults don't include them (e.g. Debian).
if [[ "${fpath[*]}" != *"functions/Misc"* ]]; then
  local _zfn_base
  for _zfn_base in /usr/share/zsh/functions /usr/share/zsh/*/functions; do
    [[ -d ${_zfn_base}/Misc ]] && fpath=(${_zfn_base}/{Misc,Completion,Completion/{Base,Linux,Unix,Zsh},Prompts,Zle,VCS_Info} ${fpath}) && break
  done
  unset _zfn_base
fi
{{- end }}

# Cargo/Rust - auto-injected by ~/.cargo/env on most systems
# [ -s "$HOME/.cargo/env" ] && source "$HOME/.cargo/env"

# =============================================================================
# Tool defaults (sourced for all zsh sessions)
# =============================================================================

# Set fd as the default source for fzf (faster than find)
# On Debian the binary is `fdfind`; on macOS/brew it's `fd`
{{- if eq .chezmoi.os "linux" }}
export FZF_DEFAULT_COMMAND='fdfind --type f --hidden --follow --exclude .git'
{{- else }}
export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
{{- end }}
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"

# =============================================================================
# PATH additions for all shell types
# =============================================================================

# Tools (Linux: ~/.local/bin is standard for user-installed binaries)
{{- if eq .chezmoi.os "darwin" }}
export PATH=$PATH:$HOME/Tools/bin
{{- end }}
export PATH=$PATH:$HOME/.local/bin

{{- if eq .chezmoi.os "darwin" }}
# Dart/Flutter (macOS)
export PATH="$PATH":"$HOME/.pub-cache/bin"
{{- end }}

# NVM/FNM (lazy loaded in .zshrc, but NVM_DIR/FNM_DIR must be set here)
{{- if eq .chezmoi.os "darwin" }}
export FNM_DIR="$HOME/.fnm"
export PATH=$PATH:$FNM_DIR
{{- else }}
export FNM_DIR="$HOME/.fnm"
export PATH=$PATH:$FNM_DIR
# Add Node binaries to PATH (fnm - all installed versions)
if [ -d "$FNM_DIR/node-versions" ]; then
  for dir in "$FNM_DIR/node-versions"/*/installation/bin; do
    [ -d "$dir" ] && export PATH="$PATH:$dir"
  done
fi
{{- end }}

# zsh site-functions paths
# Intel Mac (Homebrew): /usr/local/share/zsh/site-functions — usually already in fpath
# Apple Silicon Mac (Homebrew): /opt/homebrew/share/zsh/site-functions
# Linux (custom builds): may need manual addition
# Only prepend if the path exists AND is not already in fpath.
if [[ -n "${fpath}" ]] && (( ! ${fpath[(I)/usr/local/share/zsh/site-functions]} )) && [[ -d /usr/local/share/zsh/site-functions ]]; then
  fpath=(/usr/local/share/zsh/site-functions ${fpath})
fi
{{- if eq .chezmoi.os "darwin" }}
if [[ -n "${fpath}" ]] && (( ! ${fpath[(I)/opt/homebrew/share/zsh/site-functions]} )) && [[ -d /opt/homebrew/share/zsh/site-functions ]]; then
  fpath=(/opt/homebrew/share/zsh/site-functions ${fpath})
fi
{{- end }}

{{- if eq .chezmoi.os "darwin" }}
# Homebrew
export HOMEBREW_NO_GITHUB_API=1
{{- end }}

# Go
{{- if eq .chezmoi.os "darwin" }}
export GOPATH=$HOME/Dev
export GOROOT="$(brew --prefix golang)/libexec"
export GOPROXY=https://proxy.golang.org,direct
export GOSUMDB="sum.golang.org"
export PATH=$PATH:$GOPATH/bin:$GOROOT/bin
{{- else }}
export GOPATH=$HOME/Dev
export GOPROXY=https://proxy.golang.org,direct
export GOSUMDB="sum.golang.org"
export PATH=$PATH:$GOPATH/bin
{{- end }}
